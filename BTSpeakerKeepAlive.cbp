<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="BT Speaker Keep-Alive" />
		<Option pch_mode="2" />
		<Option compiler="gcc-mingw64" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/BTSpeakerKeep-Alive" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc-mingw64" />
				<Compiler>
					<Add option="-finput-charset=UTF-8 -fexec-charset=UTF-8" />
					<Add option="-std=c++14 -pthread" />
				</Compiler>
				<Linker>
					<Add library="gdi32" />
					<Add library="ole32" />
					<Add library="uuid" />
					<Add library="propsys" />
					<Add library="shell32" />
					<Add library="advapi32" />
					<Add option="-pthread" />
					<Add option="-static" />
					<Add option="-mwindows" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/BTSpeakerKeep-Alive" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc-mingw64" />
				<Compiler>
					<Add option="-finput-charset=UTF-8 -fexec-charset=UTF-8 -std=c++14 -pthread" />
				</Compiler>
				<Linker>
					<Add library="gdi32" />
					<Add library="ole32" />
					<Add library="uuid" />
					<Add library="propsys" />
					<Add library="shell32" />
					<Add library="advapi32" />
					<Add option="-pthread" />
					<Add option="-static" />
					<Add option="-mwindows" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="BTSpeakerKeepAlive.cpp" />
		<Unit filename="BTSpeakerKeepAlive.rc" />
		<Unit filename="translations/en.ini" />
		<Unit filename="translations/es.ini" />
		<Unit filename="translations/de.ini" />
		<Unit filename="translations/ja.ini" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
